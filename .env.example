# Environment Variables — Shubhash Website
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ─── Google Places API (Vercel serverless) ──────────────
# Enable "Places API (New)" in Google Cloud Console.
# Find your Place ID at: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=your_google_place_id_here

# ─── Supabase (set in config.js, NOT here) ──────────────
# The Supabase anon key is INTENTIONALLY public and safe to expose in the browser.
# Set SUPABASE_URL and SUPABASE_ANON_KEY in config.js.
# Do NOT put your Supabase service_role key anywhere in this project.
